# Copy this file to .env, or run: python scripts/make_env.py
# Never commit .env. It is listed in .gitignore.

# Signs the access tokens. At least 32 characters.
JWT_SECRET=

# Client that submits findings and reads results.
ANALYST_CLIENT_ID=analyst
ANALYST_CLIENT_SECRET=

# Client that approves or rejects high-impact fixes and reads the audit log.
APPROVER_CLIENT_ID=approver
APPROVER_CLIENT_SECRET=

# Optional. Without it the service uses the built-in rules only.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
